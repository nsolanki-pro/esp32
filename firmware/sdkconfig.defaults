CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_LWIP_LOCAL_HOSTNAME="esp32"

# Power management: automatic light sleep when idle
CONFIG_PM_ENABLE=y
CONFIG_PM_PROFILING=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_SLP_IRAM_OPT=y
CONFIG_PM_RTOS_IDLE_OPT=y
CONFIG_ESP_WIFI_SLP_IRAM_OPT=y

# IPv4 only: skip IPv6 multicast/ND processing
CONFIG_LWIP_IPV6=n

# OTA: two 1.7 MB app slots; bootloader rolls back an unconfirmed new image
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Clock: SNTP re-sync every 6 h; log lines carry wall-clock time once synced (see /logs)
CONFIG_LWIP_SNTP_UPDATE_DELAY=21600000
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y

# Wi-Fi CSI for the motion sensor (switched on at runtime in the settings)
CONFIG_ESP_WIFI_CSI_ENABLED=y
